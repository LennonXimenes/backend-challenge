{
  "name": "wagering-processor",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.4",
  "scripts": {
    "start": "bun src/main.ts",
    "start:dev": "bun --watch src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "migration:up": "bun src/infra/database/migrate.ts up",
    "migration:down": "bun src/infra/database/migrate.ts down",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration"
  },
  "dependencies": {
    "@mikro-orm/core": "^7.2.5",
    "@mikro-orm/migrations": "^7.2.5",
    "@mikro-orm/postgresql": "^7.2.5",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "decimal.js": "^10.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "5.9.3"
  }
}
